<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#0B132B"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Flood &amp; Jeepney Guide"
            android:textColor="#FFFFFF"
            android:textSize="24sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Check low-lying roads and navigate to jeepney terminals."
            android:textColor="#93C5FD"
            android:textSize="13sp"
            android:layout_marginBottom="20dp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="FLOOD-PRONE AREAS"
            android:textColor="#60A5FA"
            android:textSize="12sp"
            android:textStyle="bold"
            android:layout_marginBottom="10dp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="#152238"
            android:orientation="vertical"
            android:padding="16dp"
            android:layout_marginBottom="10dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Araneta St. (Downtown / Central Market)"
                android:textColor="#FFFFFF"
                android:textSize="15sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="STATUS: ANKLE-DEEP FLOODING"
                android:textColor="#FBBF24"
                android:textSize="12sp"
                android:textStyle="bold"
                android:layout_marginTop="4dp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Passable to jeepneys, expect heavy slowdown."
                android:textColor="#94A3B8"
                android:textSize="12sp"
                android:layout_marginTop="2dp" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="#152238"
            android:orientation="vertical"
            android:padding="16dp"
            android:layout_marginBottom="24dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Lacson St. - Mandalagan Bridge Area"
                android:textColor="#FFFFFF"
                android:textSize="15sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="STATUS: PASSABLE / WET ROAD"
                android:textColor="#34D399"
                android:textSize="12sp"
                android:textStyle="bold"
                android:layout_marginTop="4dp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Normal traffic flow; use covered waiting sheds."
                android:textColor="#94A3B8"
                android:textSize="12sp"
                android:layout_marginTop="2dp" />
        </LinearLayout>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="JEEPNEY TERMINALS (TAP TO NAVIGATE)"
            android:textColor="#60A5FA"
            android:textSize="12sp"
            android:textStyle="bold"
            android:layout_marginBottom="10dp" />

        <Button
            android:id="@+id/btnJeep1"
            style="?attr/materialButtonOutlinedStyle"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:layout_marginBottom="8dp"
            android:backgroundTint="#1C2541"
            android:gravity="start|center_vertical"
            android:text="Bata - Libertad Route (Northbound Stop)"
            android:textAllCaps="false"
            android:textColor="#FFFFFF"
            app:strokeColor="#334155" />

        <Button
            android:id="@+id/btnJeep2"
            style="?attr/materialButtonOutlinedStyle"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:layout_marginBottom="8dp"
            android:backgroundTint="#1C2541"
            android:gravity="start|center_vertical"
            android:text="Mandalagan - Libertad Route (Lacson Stop)"
            android:textAllCaps="false"
            android:textColor="#FFFFFF"
            app:strokeColor="#334155" />

        <Button
            android:id="@+id/btnJeep3"
            style="?attr/materialButtonOutlinedStyle"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:backgroundTint="#1C2541"
            android:gravity="start|center_vertical"
            android:text="Homesite - Central Market Terminal"
            android:textAllCaps="false"
            android:textColor="#FFFFFF"
            app:strokeColor="#334155" />

    </LinearLayout>
</ScrollView>